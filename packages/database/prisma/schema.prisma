generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionType {
  PRODUCT
  BRAND
}

enum NotificationChannel {
  EMAIL
  PUSH
  KAKAO
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  passwordHash         String?              @map("password_hash")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  notificationSettings NotificationSetting?
  subscriptions        Subscription[]
  notificationLogs     NotificationLog[]
  pushSubscriptions    PushSubscription[]

  @@map("users")
}

model NotificationSetting {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  pushEnabled  Boolean  @default(false) @map("push_enabled")
  kakaoEnabled Boolean  @default(false) @map("kakao_enabled")
  kakaoPhone   String?  @map("kakao_phone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model Subscription {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  keyword   String
  type      SubscriptionType
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword, type])
  @@map("subscriptions")
}

model Recall {
  id               String            @id @default(uuid())
  externalId       String?           @unique @map("external_id")
  productName      String            @map("product_name")
  company          String
  reason           String            @db.Text
  announcedAt      DateTime          @map("announced_at")
  sourceUrl        String            @map("source_url")
  rawData          Json              @map("raw_data")
  createdAt        DateTime          @default(now()) @map("created_at")

  // 추가 필드
  address         String?            @map("address")
  telNo           String?            @map("tel_no")
  barcodeNo       String?            @map("barcode_no")
  packagingUnit   String?            @map("packaging_unit")
  manufacturedAt  String?            @map("manufactured_at")
  recallMethod    String?            @map("recall_method")
  expiryDate      String?            @map("expiry_date")
  productType     String?            @map("product_type")
  productTypeName String?            @map("product_type_name")
  imageUrls       String[]           @map("image_urls")
  recallGrade     String?            @map("recall_grade")
  productReportNo String?            @map("product_report_no")
  licenseNo       String?            @map("license_no")

  notificationLogs NotificationLog[]

  @@map("recalls")
}

model NotificationLog {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  recallId  String              @map("recall_id")
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?           @map("sent_at")
  errorMsg  String?             @map("error_msg")
  createdAt DateTime            @default(now()) @map("created_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recall    Recall              @relation(fields: [recallId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}
